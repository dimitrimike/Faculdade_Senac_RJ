package biblioteca;

public class LivroAcervo {
	
	private int codLivro;
	private String titulo;
	private int totalExemplares;
	private int exemplaresEmprestados;
	
	LivroAcervo (String titulo, int codLivro, int totalExemplares, int exemplaresEmprestados){
		this.titulo = titulo;
		this.codLivro = codLivro;
		this.totalExemplares = totalExemplares;
		this.exemplaresEmprestados = 0;
	}
	
	public boolean realizarEmprestimo(int qtd) {
		if (qtd > this.totalExemplares) {
			System.out.println("Não há livros suficiente para " + qtd + "unidades do livro.");
			return(false);
		} else {
			this.totalExemplares -= qtd;
		}
	}

}
