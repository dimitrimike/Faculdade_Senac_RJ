package biblioteca;

public class LivroAcervo {
	
	private int codLivro;
	private String titulo;
	private int totalExemplares;
	private int exemplaresEmprestados;
	
	LivroAcervo (String titulo, int codLivro, int totalExemplares, int exemplaresEmprestados){
		this.titulo = titulo;
		this.codLivro = codLivro;
		this.totalExemplares = totalExemplares;
		this.exemplaresEmprestados = 0;
	}
	
	public boolean realizarEmprestimo(int qtd) {
		if (this.totalExemplares > this.exemplaresEmprestados) {
			this.exemplaresEmprestados += qtd;
			return(true);
		} else {
			System.out.println("Não há livros suficiente para " + qtd + " unidades do livro.");
			return(false);
		}
	}
	
	public boolean realizarDevolucao(int qtd) {
		if (this.exemplaresEmprestados > 0) {
			System.out.println("Não há " + qtd + " unidades emprestadas do livro.");
			return(false);
		} else {
			this.totalExemplares += qtd;
			this.exemplaresEmprestados -= qtd;
			return(true);
		}
	}
	
	public void consultarLivro() {
		System.out.println("O livro " + this.titulo + ", código " + this.codLivro + ", tem " + this.totalExemplares + " exemplares.");
		System.out.println("Existem " + this.exemplaresEmprestados + " exemplares do livro emprestados.");
	}

}
