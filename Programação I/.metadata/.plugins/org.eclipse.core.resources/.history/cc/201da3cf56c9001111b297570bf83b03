package logistica.modelo;

public class EnvioPriv {
	public String codigoRastreio;
	public double pesoKg;
	public int tipoEntrega;
	public double valorFrete;
	
	public double calcularValorFrete() {
		switch (this.tipoEntrega) {
		case 1:
			valorFrete = 10 + 5*pesoKg;
			break;
		case 2:
			valorFrete = 25 + 9*pesoKg;
			break;
		case 3:
			valorFrete = 60 + 20*pesoKg;
			break;
		default:
			valorFrete = 15 + 4*pesoKg;
		}
		return (valorFrete);
	}
}
