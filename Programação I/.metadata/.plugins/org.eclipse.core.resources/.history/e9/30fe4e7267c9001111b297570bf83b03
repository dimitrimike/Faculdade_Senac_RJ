package validacao;

public class ValidaSKU {
	private String skuCodigo;
	private String skuValidado;
	
	ValidaSKU (String sku){
		this.skuCodigo = sku;
	}
	
	public boolean AjustarSKU() {
		String skuTrim = this.skuCodigo.trim();
		String skuUpperCase = skuTrim.toUpperCase();
		
		if (skuUpperCase.indexOf("PRD-")==-1)
			return(false);
		else
			this.skuValidado = skuUpperCase.substring(4,skuUpperCase.length());
			return(true);
	}
	
	public void mostrarSKU() {
		String numsku = this.skuValidado.substring(0,skuValidado.length());
		System.out.println("Código numperico final: " + numsku);
	}
	
	public static void main(String[] args) {
		ValidaSKU sku1 = new ValidaSKU("PRD-12345");
		ValidaSKU sku2 = new ValidaSKU("PRD-34129");
		
		if(sku1.AjustarSKU())
			sku1.mostrarSKU();
		else 
			System.out.println("Erro de digitação do código");
		
		if(sku2.AjustarSKU())
			sku2.mostrarSKU();
		else 
			System.out.println("Erro de digitação do código");
			
	}

}
