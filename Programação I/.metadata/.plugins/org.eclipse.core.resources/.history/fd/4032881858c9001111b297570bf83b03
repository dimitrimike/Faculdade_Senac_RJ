package logistica.modelo;

public class TesteEnvioPriv {
	public static void main(String[] args) {
		
		EnvioPriv pedido1 = new EnvioPriv();
		pedido1.setCodigoRastreio("2SADSJ4V4");
		pedido1.setPesoKg(12);
		pedido1.setTipoEntrega(2);
		
		System.out.println("Rastreio do Pacote");
		System.out.println("Código: " + pedido1.codigoRastreio);
		System.out.println("Peso: " + pedido1.pesoKg);
		System.out.println("Tipo: " + pedido1.tipoEntrega);
		System.out.println("Valor: " + pedido1.calcularValorFrete() + " reais.");
	}

}
